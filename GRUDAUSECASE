## Deployment Instructions

### 1. Platform Deployment

```bash
# Deploy wallet platform
git clone https://github.com/GrudgeDaDev/gruda-wallet-platform
cd gruda-wallet-platform

# Install dependencies
npm install

# Configure environment
cp .env.example .env
vim .env  # Edit configuration

# Build and deploy
npm run build
npm run deploy:production

# Verify deployment
curl -H "Health-Check: true" https://grudgeplatform.com/wallet/health
```

### 2. Node Integration Setup

```bash
# Configure this GRD-17 node for platform integration
./gruda-node config platform \
  --endpoint https://api.grudgeplatform.com \
  --auth-token $PLATFORM_AUTH_TOKEN \
  --enable-discovery \
  --enable-remote-management

# Register with platform
./gruda-node platform register \
  --node-name "My GRUDA Node" \
  --region "us-west-2" \
  --capabilities mining,validator,bridge

# Test integration
./gruda-node platform test \
  --all-endpoints \
  --verify-auth
```

### 3. SSL/TLS Configuration

```nginx
# nginx configuration for grudgeplatform.com
server {
    listen 443 ssl http2;
    server_name grudgeplatform.com www.grudgeplatform.com;
    
    ssl_certificate /etc/ssl/certs/grudgeplatform.crt;
    ssl_certificate_key /etc/ssl/private/grudgeplatform.key;
    ssl_protocols TLSv1.3;
    ssl_ciphers TLS_AES_256_GCM_SHA384;
    
    location /wallet {
        proxy_pass http://wallet-app:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    location /api {
        proxy_pass http://api-server:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
```

